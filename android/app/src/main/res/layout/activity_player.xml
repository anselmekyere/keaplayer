<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <org.videolan.libvlc.util.VLCVideoLayout
        android:id="@+id/video"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Couche des gestes : toucher, double-toucher, glisser. -->
    <View
        android:id="@+id/touch"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Pochette pour les fichiers audio. -->
    <ImageView
        android:id="@+id/audio_art"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="center"
        android:contentDescription="@null"
        android:src="@drawable/ic_music"
        android:tint="@color/accent"
        android:visibility="gone" />

    <TextView
        android:id="@+id/osd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_osd"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp"
        android:textColor="@color/text"
        android:textSize="18sp"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/loading"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/accent"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@drawable/gradient_top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="24dp">

            <ImageButton
                android:id="@+id/back"
                style="@style/IconButton"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_back" />

            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/tracks"
                style="@style/IconButton"
                android:contentDescription="@string/tracks"
                android:src="@drawable/ic_tracks" />

            <ImageButton
                android:id="@+id/playlist"
                style="@style/IconButton"
                android:contentDescription="@string/playlist"
                android:src="@drawable/ic_playlist" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/previous"
                style="@style/IconButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_round"
                android:contentDescription="@string/previous"
                android:src="@drawable/ic_previous" />

            <ImageButton
                android:id="@+id/play"
                style="@style/IconButton"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginStart="28dp"
                android:layout_marginEnd="28dp"
                android:background="@drawable/bg_round"
                android:contentDescription="@string/pause"
                android:padding="14dp"
                android:src="@drawable/ic_pause" />

            <ImageButton
                android:id="@+id/next"
                style="@style/IconButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_round"
                android:contentDescription="@string/next"
                android:src="@drawable/ic_next" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/gradient_bottom"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="28dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:minWidth="52dp"
                    android:text="0:00"
                    android:textColor="@color/text"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/seek"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:max="1000"
                    android:progressTint="@color/accent"
                    android:thumbTint="@color/accent" />

                <TextView
                    android:id="@+id/duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:gravity="end"
                    android:minWidth="52dp"
                    android:text="0:00"
                    android:textColor="@color/text"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/lock"
                    style="@style/IconButton"
                    android:contentDescription="@string/lock"
                    android:src="@drawable/ic_lock" />

                <ImageButton
                    android:id="@+id/aspect"
                    style="@style/IconButton"
                    android:contentDescription="@string/aspect"
                    android:src="@drawable/ic_aspect" />

                <ImageButton
                    android:id="@+id/rotate"
                    style="@style/IconButton"
                    android:contentDescription="@string/rotate"
                    android:src="@drawable/ic_rotate" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/speed"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="1×"
                    android:textColor="@color/text"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/snapshot"
                    style="@style/IconButton"
                    android:contentDescription="@string/snapshot"
                    android:src="@drawable/ic_camera" />

                <ImageButton
                    android:id="@+id/pip"
                    style="@style/IconButton"
                    android:contentDescription="@string/pip"
                    android:src="@drawable/ic_pip" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <ImageButton
        android:id="@+id/unlock"
        style="@style/IconButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|start"
        android:layout_margin="20dp"
        android:background="@drawable/bg_round"
        android:contentDescription="@string/lock"
        android:src="@drawable/ic_lock"
        android:tint="@color/accent"
        android:visibility="gone" />
</FrameLayout>

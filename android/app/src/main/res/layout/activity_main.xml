<?xml version="1.0" encoding="utf-8"?>
<!-- Une seule fenêtre, comme la version de bureau : barre de menus, scène
     (vidéo, accueil, commandes, panneau Pistes) et liste de lecture à droite. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <HorizontalScrollView
        android:id="@+id/menubar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/bg_menubar"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/menubar_items"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <FrameLayout
        android:id="@+id/body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/stage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/black">

            <org.videolan.libvlc.util.VLCVideoLayout
                android:id="@+id/video"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <View
                android:id="@+id/touch"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ImageView
                android:id="@+id/audio_art"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_music"
                android:tint="@color/accent"
                android:visibility="gone" />

            <!-- Accueil du bureau (.empty) : logo, titre, deux boutons, rappel des raccourcis. -->
            <ScrollView
                android:id="@+id/empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_stage_empty"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:contentDescription="@null"
                        android:src="@drawable/logo_play" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/app_name"
                        android:textColor="@color/text"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="@string/empty_text"
                        android:textColor="@color/muted" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/open_files"
                            style="@style/PrimaryButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/open_files" />

                        <Button
                            android:id="@+id/open_folder"
                            style="@style/SecondaryButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/open_folder" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/open_url"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginTop="4dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="@string/open_url"
                        android:textColor="@color/accent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="@string/empty_hint"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/recents_box"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/PanelHeading"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:text="@string/recents" />

                            <TextView
                                android:id="@+id/clear_recents"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:background="?android:attr/selectableItemBackground"
                                android:gravity="center"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:text="@string/clear_recents"
                                android:textColor="@color/accent" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/recents"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <!-- OSD en haut à droite, comme sur le bureau. -->
            <TextView
                android:id="@+id/osd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="16dp"
                android:background="@drawable/bg_osd"
                android:maxWidth="320dp"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp"
                android:textColor="@color/text"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/loading"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/accent"
                android:visibility="gone" />

            <!-- Barre de commandes du bureau (.controls). -->
            <LinearLayout
                android:id="@+id/controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="@drawable/gradient_controls"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingTop="24dp"
                android:paddingEnd="10dp"
                android:paddingBottom="6dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:gravity="center"
                        android:minWidth="48dp"
                        android:text="0:00"
                        android:textColor="@color/muted"
                        android:textSize="13sp" />

                    <SeekBar
                        android:id="@+id/seek"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:max="1000"
                        android:progressTint="@color/accent"
                        android:thumbTint="@color/accent" />

                    <TextView
                        android:id="@+id/duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:gravity="center"
                        android:minWidth="48dp"
                        android:text="0:00"
                        android:textColor="@color/muted"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/prev"
                        style="@style/IconButton"
                        android:contentDescription="@string/previous"
                        android:src="@drawable/ic_previous" />

                    <ImageButton
                        android:id="@+id/play"
                        style="@style/IconButton"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:contentDescription="@string/play"
                        android:padding="11dp"
                        android:src="@drawable/ic_play" />

                    <ImageButton
                        android:id="@+id/next"
                        style="@style/IconButton"
                        android:contentDescription="@string/next"
                        android:src="@drawable/ic_next" />

                    <ImageButton
                        android:id="@+id/mute"
                        style="@style/IconButton"
                        android:contentDescription="@string/mute"
                        android:src="@drawable/ic_volume" />

                    <SeekBar
                        android:id="@+id/volume"
                        android:layout_width="96dp"
                        android:layout_height="36dp"
                        android:contentDescription="@string/volume"
                        android:max="200"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:progressTint="@color/accent"
                        android:thumbTint="@color/accent" />

                    <TextView
                        android:id="@+id/title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:textColor="@color/muted" />

                    <TextView
                        android:id="@+id/badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge"
                        android:letterSpacing="0.06"
                        android:paddingStart="6dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="6dp"
                        android:paddingBottom="2dp"
                        android:textAllCaps="true"
                        android:textColor="@color/muted"
                        android:textSize="11sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/speed"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_select"
                        android:contentDescription="@string/speed"
                        android:gravity="center"
                        android:minWidth="64dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="1× ▾"
                        android:textColor="@color/text" />

                    <ImageButton
                        android:id="@+id/frame"
                        style="@style/IconButton"
                        android:contentDescription="@string/frame"
                        android:src="@drawable/ic_frame" />

                    <ImageButton
                        android:id="@+id/snapshot"
                        style="@style/IconButton"
                        android:contentDescription="@string/snapshot"
                        android:src="@drawable/ic_camera" />

                    <ImageButton
                        android:id="@+id/tracks_toggle"
                        style="@style/IconButton"
                        android:contentDescription="@string/tracks"
                        android:src="@drawable/ic_tracks" />

                    <ImageButton
                        android:id="@+id/playlist_toggle"
                        style="@style/IconButton"
                        android:contentDescription="@string/playlist"
                        android:src="@drawable/ic_playlist" />

                    <ImageButton
                        android:id="@+id/fullscreen"
                        style="@style/IconButton"
                        android:contentDescription="@string/fullscreen"
                        android:src="@drawable/ic_fullscreen" />
                </LinearLayout>
            </LinearLayout>

            <!-- Aperçu de la barre de progression (miniature + instant), comme le survol du bureau. -->
            <LinearLayout
                android:id="@+id/preview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:background="@drawable/bg_panel"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="4dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/preview_image"
                    android:layout_width="160dp"
                    android:layout_height="90dp"
                    android:background="@android:color/black"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/preview_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:paddingStart="4dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="4dp"
                    android:textColor="@color/text"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Panneau « Pistes, son et décalages » du bureau (.panel.tracks). -->
            <ScrollView
                android:id="@+id/tracks_panel"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="14dp"
                android:layout_marginBottom="104dp"
                android:background="@drawable/bg_panel"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp">

                    <TextView
                        style="@style/PanelHeading"
                        android:text="@string/tracks_heading" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical">

                        <TextView
                            style="@style/PanelLabel"
                            android:text="@string/audio" />

                        <Spinner
                            android:id="@+id/audio_track"
                            style="@style/Select" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical">

                        <TextView
                            style="@style/PanelLabel"
                            android:text="@string/subtitles" />

                        <Spinner
                            android:id="@+id/subtitle_track"
                            style="@style/Select" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/add_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_gravity="end"
                        android:background="?android:attr/selectableItemBackground"
                        android:gravity="center"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:text="@string/add_subtitle"
                        android:textColor="@color/accent"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical">

                        <TextView
                            style="@style/PanelLabel"
                            android:text="@string/audio_delay" />

                        <Button
                            android:id="@+id/audio_delay_minus"
                            style="@style/SmallButton"
                            android:contentDescription="@string/audio_delay_minus"
                            android:text="−" />

                        <TextView
                            android:id="@+id/audio_delay"
                            android:layout_width="72dp"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:gravity="center"
                            android:text="0 ms"
                            android:textColor="@color/text" />

                        <Button
                            android:id="@+id/audio_delay_plus"
                            style="@style/SmallButton"
                            android:contentDescription="@string/audio_delay_plus"
                            android:text="+" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical">

                        <TextView
                            style="@style/PanelLabel"
                            android:text="@string/subtitle_delay" />

                        <Button
                            android:id="@+id/sub_delay_minus"
                            style="@style/SmallButton"
                            android:contentDescription="@string/sub_delay_minus"
                            android:text="−" />

                        <TextView
                            android:id="@+id/sub_delay"
                            android:layout_width="72dp"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:gravity="center"
                            android:text="0 ms"
                            android:textColor="@color/text" />

                        <Button
                            android:id="@+id/sub_delay_plus"
                            style="@style/SmallButton"
                            android:contentDescription="@string/sub_delay_plus"
                            android:text="+" />
                    </LinearLayout>

                    <TextView
                        style="@style/PanelHeading"
                        android:layout_marginTop="14dp"
                        android:text="@string/sound_heading" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical">

                        <TextView
                            style="@style/PanelLabel"
                            android:text="@string/equalizer" />

                        <Spinner
                            android:id="@+id/eq_preset"
                            style="@style/Select" />
                    </LinearLayout>

                    <CheckBox
                        android:id="@+id/normalize"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:buttonTint="@color/accent"
                        android:text="@string/normalize"
                        android:textColor="@color/text" />

                    <TextView
                        android:id="@+id/info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </ScrollView>
        </FrameLayout>

        <!-- Liste de lecture du bureau (.playlist) : à droite, 300 dp. -->
        <LinearLayout
            android:id="@+id/playlist_panel"
            android:layout_width="300dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="@color/playlist_bg"
            android:elevation="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="6dp">

                <TextView
                    style="@style/PanelHeading"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/playlist" />

                <ImageButton
                    android:id="@+id/add_files"
                    style="@style/IconButton"
                    android:contentDescription="@string/add_files"
                    android:src="@drawable/ic_add" />

                <ImageButton
                    android:id="@+id/clear_playlist"
                    style="@style/IconButton"
                    android:contentDescription="@string/clear_playlist"
                    android:src="@drawable/ic_close" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/line" />

            <ListView
                android:id="@+id/playlist_items"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="@null"
                android:paddingTop="4dp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
